{
  "name": "@ctdt/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "dev:setup": "node scripts/dev-setup.mjs",
    "mail:start": "docker compose --profile mail up -d mailpit",
    "school-db:sim:start": "docker compose --profile school-db-sim up -d school-db-sim",
    "school-db:sim:seed": "tsx scripts/school-db-sim/seed.ts",
    "school-db:sim:stop": "docker compose --profile school-db-sim stop school-db-sim",
    "build": "nest build",
    "dev": "nest start -b swc --watch",
    "dev:tsc": "nest start --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "dut:extract": "tsx prisma/seed-data/dut/extract/extract.ts",
    "prisma:seed:dut": "tsx prisma/seed-dut.ts",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:world": "tsx prisma/e2e-world.ts",
    "e2e:purge": "tsx prisma/e2e-purge.ts",
    "db:demo-account": "tsx prisma/demo-account.ts",
    "db:demo-fixtures": "tsx prisma/demo-fixtures.ts",
    "backup:drill": "tsx scripts/backup-restore-drill.ts",
    "db:rebuild:real": "tsx scripts/rebuild-real.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "mssql": "^12.7.13",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "puppeteer": "^24.43.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mssql": "^12.3.0",
    "@types/multer": "2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
