generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ImportType {
  COURSE_CATALOG
  CURRICULUM
  STUDENT_LIST
  ACADEMIC_RESULT
}

enum ImportBatchStatus {
  VALIDATING
  DRY_RUN
  COMMITTING
  COMMITTED
  ABORTED
}

enum OrgUnitType {
  UNIVERSITY
  FACULTY
  OFFICE
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

enum SubjectGroupStatus {
  ACTIVE
  INACTIVE
}

enum SubjectGroupMemberRole {
  MEMBER
  COORDINATOR
}

enum CourseType {
  THEORY
  PRACTICE
  LAB
  PROJECT
  CAPSTONE
  INTERNSHIP
  CONDITIONAL
}

enum CourseStatus {
  ACTIVE
  DISCONTINUED
  CANCELLED
}

enum DegreeLevel {
  ENGINEER
  BACHELOR
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum ProgramVersionStatus {
  DRAFT
  PENDING
  ACTIVE
  HISTORICAL
}

enum ScopeSource {
  NONE
  PROGRAM_DIRECTOR
  SUBJECT_GROUP_COORDINATOR
  SUBJECT_GROUP_MEMBER
  OWN_ENROLLMENT
}

enum FunctionGroup {
  SYSTEM_ADMIN
  COURSE_CATALOG
  PROGRAM
  LEARNING_OUTCOME
  SYLLABUS
  APPROVAL
  VERSION
  DATA_REPORT
  STUDENT_LOOKUP
}

enum PermissionMode {
  DIRECT
  VIA_REQUEST
}

enum PermissionScope {
  ALL
  SCOPED
}

enum ScopeType {
  SYSTEM
  UNIT
  ASSIGNMENT
}

enum ChangeRequestType {
  GRADING_FORMULA
  OUTCOME
  SYLLABUS_CONTENT
  CURRICULUM
  COURSE_RELATION
  PROGRAM_INFO
  ORGANIZATION
}

enum ChangeTargetType {
  COURSE
  PROGRAM
  SUBJECT_GROUP
}

enum ChangeRequestStatus {
  DRAFT
  PENDING_COORDINATOR
  PENDING_DIRECTOR
  PENDING_ACADEMIC_OFFICE
  APPROVED
  EFFECTIVE
  REJECTED
  WITHDRAWN
}

enum RequestOrigin {
  UNIVERSITY
  FACULTY
}

enum ApprovalAction {
  PENDING
  APPROVE
  RETURN
  REJECT
}

enum NotificationType {
  REQUEST_AWAITING_YOU
  REQUEST_RETURNED
  REQUEST_REJECTED
  REQUEST_APPROVED
  REQUEST_OVERRIDDEN
  REQUEST_COMMENTED
  REQUEST_EFFECTIVE
  GRADUATION_CONCLUSION_CHANGED
  SCHOOL_SYNC_FAILED
  DELEGATION_RECEIVED
  REQUEST_DEADLINE_REMINDER
}

enum NotificationReadStatus {
  UNREAD
  READ
}

enum ChangeDocumentType {
  SUBMISSION
  MINUTES
  COUNCIL_MINUTES
  REVIEW_MINUTES
  OFFICIAL_LETTER
}

model OrgUnit {
  id              String           @id @default(cuid(2))
  unitCode        String           @unique
  unitName        String
  unitType        OrgUnitType
  parentUnitId    String?
  parentUnit      OrgUnit?         @relation("OrgUnitTree", fields: [parentUnitId], references: [id], onDelete: Restrict)
  childUnits      OrgUnit[]        @relation("OrgUnitTree")
  status          OrgUnitStatus    @default(ACTIVE)
  users           User[]
  roleAssignments RoleAssignment[]
  subjectGroups   SubjectGroup[]
  ownedCourses    Course[]         @relation("CourseOwnerFaculty")
  programs        Program[]        @relation("ProgramFaculty")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([parentUnitId])
}

model User {
  integrationClientsCreated IntegrationClient[]         @relation("IntegrationClientCreator")
  requestedSchoolSyncRuns   SyncLog[]                   @relation("SchoolSyncRequester")
  graduationAudits          GraduationAudit[]           @relation("GraduationReviewer")
  graduationBatches         GraduationBatch[]           @relation("GraduationBatchRequester")
  student                   Student?                    @relation("StudentAccount")
  createdEnrollments        ProgramEnrollment[]         @relation("EnrollmentCreator")
  importBatches             ImportBatch[]               @relation("ImportBatchPerformedBy")
  id                        String                      @id @default(cuid(2))
  userCode                  String                      @unique
  fullName                  String
  email                     String?
  status                    UserStatus                  @default(ACTIVE)
  username                  String                      @unique
  passwordHash              String
  mustChangePassword        Boolean                     @default(false)
  /// Demo accounts only (prisma/demo-account.ts): may approve requests they created.
  canSelfApprove            Boolean                     @default(false)
  orgUnitId                 String?
  orgUnit                   OrgUnit?                    @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  roleAssignments           RoleAssignment[]            @relation("AssignmentHolder")
  grantedAssignments        RoleAssignment[]            @relation("AssignmentGrantor")
  revokedAssignments        RoleAssignment[]            @relation("AssignmentRevoker")
  subjectGroupMemberships   SubjectGroupMember[]        @relation("MembershipHolder")
  grantedMemberships        SubjectGroupMember[]        @relation("MembershipGrantor")
  revokedMemberships        SubjectGroupMember[]        @relation("MembershipRevoker")
  updatedRolePermissions    RolePermission[]
  programDirectorships      ProgramDirectorAssignment[] @relation("ProgramDirector")
  grantedDirectorships      ProgramDirectorAssignment[] @relation("ProgramDirectorAssignedBy")
  revokedDirectorships      ProgramDirectorAssignment[] @relation("ProgramDirectorRevokedBy")
  creditMismatchAcceptances ProgramVersion[]            @relation("CreditMismatchAcceptedBy")
  publishedVersions         ProgramVersion[]            @relation("VersionPublisher")
  syllabusAttachments       SyllabusAttachment[]        @relation("SyllabusAttachmentUploadedBy")
  changeRequests            ChangeRequest[]             @relation("ChangeRequestCreator")
  approvalSteps             ApprovalStep[]              @relation("ApprovalStepApprover")
  performedApprovalSteps    ApprovalStep[]              @relation("ApprovalStepPerformer")
  changeRequestDocuments    ChangeRequestDocument[]     @relation("ChangeRequestDocumentUploader")
  comments                  Comment[]                   @relation("CommentAuthor")
  notifications             Notification[]              @relation("NotificationRecipient")
  delegationsGranted        ApprovalDelegation[]        @relation("DelegationGrantor")
  delegationsReceived       ApprovalDelegation[]        @relation("DelegationRecipient")
  delegationsCreated        ApprovalDelegation[]        @relation("DelegationCreator")
  delegationsRevoked        ApprovalDelegation[]        @relation("DelegationRevoker")
  reminderDispatches        ApprovalReminderDispatch[]
  notificationPreference    NotificationPreference?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  @@index([orgUnitId])
}

model SubjectGroup {
  id             String               @id @default(cuid(2))
  groupCode      String               @unique
  groupName      String
  facultyId      String
  faculty        OrgUnit              @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  status         SubjectGroupStatus   @default(ACTIVE)
  members        SubjectGroupMember[]
  ownedCourses   Course[]             @relation("CourseOwnerGroup")
  changeRequests ChangeRequest[]
  approvalSteps  ApprovalStep[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([facultyId])
}

model Course {
  schoolClasses        SchoolClassMirror[]
  academicResults      AcademicResult[]
  id                   String                 @id @default(cuid(2))
  courseCode           String                 @unique
  courseName           String
  englishName          String?
  credits              Decimal                @db.Decimal(5, 2)
  courseType           CourseType
  status               CourseStatus           @default(ACTIVE)
  ownerFacultyId       String
  ownerFaculty         OrgUnit                @relation("CourseOwnerFaculty", fields: [ownerFacultyId], references: [id], onDelete: Restrict)
  ownerGroupId         String?
  ownerGroup           SubjectGroup?          @relation("CourseOwnerGroup", fields: [ownerGroupId], references: [id], onDelete: Restrict)
  equivalenceGroupId   String?
  equivalenceGroup     EquivalentCourseGroup? @relation("CourseEquivalence", fields: [equivalenceGroupId], references: [id], onDelete: SetNull)
  relationsAsSource    CourseRelation[]       @relation("RelationSource")
  relationsAsTarget    CourseRelation[]       @relation("RelationTarget")
  curriculumItems      CurriculumItem[]       @relation("CurriculumItemCourse")
  curriculumRequisites CurriculumRequisite[]  @relation("CurriculumRequisiteSource")
  syllabi              Syllabus[]
  changeRequests       ChangeRequest[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([ownerFacultyId])
  @@index([ownerGroupId])
  @@index([courseName])
  @@index([equivalenceGroupId])
}

enum CourseRelationType {
  PRIOR
  PREREQUISITE
  COREQUISITE
  REPLACEMENT
}

// sourceCourse = the course studied first (or the discontinued one); targetCourse = the course that has the requirement.
// Two CHECK constraints are added by hand in the migration (not modelled by Prisma): see database_and_models.md.
model CourseRelation {
  id             String             @id @default(cuid(2))
  sourceCourseId String
  sourceCourse   Course             @relation("RelationSource", fields: [sourceCourseId], references: [id], onDelete: Restrict)
  targetCourseId String
  targetCourse   Course             @relation("RelationTarget", fields: [targetCourseId], references: [id], onDelete: Restrict)
  relationType   CourseRelationType
  minScore       Decimal?           @db.Decimal(4, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([sourceCourseId, targetCourseId, relationType])
  @@index([targetCourseId])
}

model EquivalentCourseGroup {
  id        String   @id @default(cuid(2))
  groupCode String   @unique
  note      String?
  members   Course[] @relation("CourseEquivalence")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubjectGroupMember {
  id             String                 @id @default(cuid(2))
  subjectGroupId String
  subjectGroup   SubjectGroup           @relation(fields: [subjectGroupId], references: [id], onDelete: Restrict)
  lecturerId     String
  lecturer       User                   @relation("MembershipHolder", fields: [lecturerId], references: [id], onDelete: Restrict)
  memberRole     SubjectGroupMemberRole
  validFrom      DateTime               @db.Date
  validTo        DateTime?              @db.Date
  assignedById   String?
  assignedBy     User?                  @relation("MembershipGrantor", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?                  @relation("MembershipRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([lecturerId])
  @@index([subjectGroupId])
}

model Program {
  graduationContexts   GraduationAuditContext[]
  graduationBatchItems GraduationBatchItem[]
  enrollments          ProgramEnrollment[]
  importBatches        ImportBatch[]               @relation("ImportBatchProgram")
  id                   String                      @id @default(cuid(2))
  programCode          String                      @unique
  facultyId            String
  faculty              OrgUnit                     @relation("ProgramFaculty", fields: [facultyId], references: [id], onDelete: Restrict)
  degreeLevel          DegreeLevel
  status               ProgramStatus               @default(ACTIVE)
  clonedFromId         String?
  clonedFrom           ProgramVersion?             @relation("ProgramClonedFrom", fields: [clonedFromId], references: [id], onDelete: Restrict)
  versions             ProgramVersion[]            @relation("ProgramVersions")
  directors            ProgramDirectorAssignment[]
  changeRequests       ChangeRequest[]
  approvalSteps        ApprovalStep[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([facultyId])
}

// Identity lives in Program; the description (name, major, semesters, credits) lives here so a released version keeps its own (M-3).
// Two partial unique indexes are added by hand in the migration (not modelled by Prisma): see database_and_models.md.
// A row with sourceRequestId is the working copy of a change request (F-13), not a version of the program.
model ProgramVersion {
  graduationAudits            GraduationAudit[]
  enrollmentsApplied          ProgramEnrollment[]  @relation("EnrollmentAppliedVersion")
  enrollmentsAdmitted         ProgramEnrollment[]  @relation("EnrollmentAdmissionVersion")
  importBatches               ImportBatch[]        @relation("ImportBatchVersion")
  id                          String               @id @default(cuid(2))
  programId                   String
  program                     Program              @relation("ProgramVersions", fields: [programId], references: [id], onDelete: Restrict)
  versionNumber               String?
  status                      ProgramVersionStatus @default(DRAFT)
  programName                 String
  majorCode                   String
  majorName                   String
  semesterCount               Int
  totalCredits                Decimal              @db.Decimal(5, 2)
  compulsoryCredits           Decimal              @db.Decimal(5, 2)
  electiveCredits             Decimal              @db.Decimal(5, 2)
  creditMismatchReason        String?
  creditMismatchCompulsoryGap Decimal?             @db.Decimal(5, 2)
  creditMismatchElectiveGap   Decimal?             @db.Decimal(5, 2)
  creditMismatchAcceptedById  String?
  creditMismatchAcceptedBy    User?                @relation("CreditMismatchAcceptedBy", fields: [creditMismatchAcceptedById], references: [id], onDelete: Restrict)
  creditMismatchAcceptedAt    DateTime?
  clones                      Program[]            @relation("ProgramClonedFrom")
  electiveGroups              ElectiveGroup[]
  curriculumItems             CurriculumItem[]
  plos                        PLO[]
  sourceRequestId             String?              @unique
  sourceRequest               ChangeRequest?       @relation("ProgramVersionRequestCopy", fields: [sourceRequestId], references: [id], onDelete: Restrict)
  baseVersionId               String?
  baseVersion                 ProgramVersion?      @relation("ProgramVersionBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  requestCopies               ProgramVersion[]     @relation("ProgramVersionBase")
  // Release facts (F-15). A request's working copy gets them when the request is finally approved.
  decisionNumber              String?
  signedDate                  DateTime?            @db.Date
  effectiveSemesterId         String?
  effectiveSemester           Semester?            @relation("EffectiveSemester", fields: [effectiveSemesterId], references: [id], onDelete: Restrict)
  publishedById               String?
  publishedBy                 User?                @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt                 DateTime?
  previousVersionId           String?
  previousVersion             ProgramVersion?      @relation("PreviousProgramVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions                ProgramVersion[]     @relation("PreviousProgramVersion")
  // The request whose approval produced this version; unlike sourceRequestId it is not unique (a syllabus request makes several).
  originRequestId             String?
  originRequest               ChangeRequest?       @relation("ProgramVersionOrigin", fields: [originRequestId], references: [id], onDelete: Restrict)
  // Set on a correction Draft and kept on the issued correction: the version it corrects.
  correctionOfId              String?              @unique
  correctionOf                ProgramVersion?      @relation("ProgramVersionCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  correctedBy                 ProgramVersion?      @relation("ProgramVersionCorrection")
  correctionReason            String?
  cohortVersions              CohortVersion[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@unique([programId, versionNumber])
  @@index([programId, status])
  @@index([originRequestId, status])
  @@index([status, effectiveSemesterId, createdAt])
}

model ImportBatch {
  studentCredentialDelivery StudentCredentialDelivery?
  id                        String                     @id @default(cuid(2))
  importType                ImportType
  fileName                  String
  performedById             String
  performedBy               User                       @relation("ImportBatchPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  programId                 String?
  program                   Program?                   @relation("ImportBatchProgram", fields: [programId], references: [id], onDelete: Restrict)
  versionId                 String?
  version                   ProgramVersion?            @relation("ImportBatchVersion", fields: [versionId], references: [id], onDelete: SetNull)
  status                    ImportBatchStatus
  totalRows                 Int                        @default(0)
  successRows               Int                        @default(0)
  errorRows                 Int                        @default(0)
  errorReport               Json?
  recordedAt                DateTime                   @default(now())
  finishedAt                DateTime?
  file                      ImportBatchFile?

  @@index([performedById, recordedAt])
  @@index([programId, recordedAt])
  @@index([status, recordedAt])
}

model ImportBatchFile {
  batchId   String      @id
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  content   Bytes
  sizeBytes Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Semester {
  schoolClasses          SchoolClassMirror[]
  graduationContexts     GraduationAuditContext[]
  graduationBatchItems   GraduationBatchItem[]
  admittedStudents       Student[]                @relation("StudentAdmissionSemester")
  statusStudents         Student[]                @relation("StudentStatusSemester")
  enrollmentsFrom        ProgramEnrollment[]      @relation("EnrollmentFromSemester")
  enrollmentsUntil       ProgramEnrollment[]      @relation("EnrollmentUntilSemester")
  academicResults        AcademicResult[]
  id                     String                   @id @default(cuid(2))
  semesterCode           String                   @unique
  academicYear           String
  termInYear             Int
  startDate              DateTime?                @db.Date
  // The start date is a convention-based estimate (the school calendar has no date for this term), not an official one.
  // Saving a date on MH-10 clears it. A CHECK (only with a date) is added by hand in the migration.
  startDateEstimated     Boolean                  @default(false)
  effectiveVersions      ProgramVersion[]         @relation("EffectiveSemester")
  effectiveRequests      ChangeRequest[]          @relation("RequestEffectiveSemester")
  startingCohortVersions CohortVersion[]          @relation("CohortStartSemester")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([academicYear, termInYear])
}

model Cohort {
  students    Student[]
  enrollments ProgramEnrollment[]
  id          String              @id @default(cuid(2))
  cohortCode  String              @unique
  intakeYear  Int
  versions    CohortVersion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// Which version a cohort studies under, from which semester (F-16 reassigns; F-15 writes at release and correction).
model CohortVersion {
  enrollments      ProgramEnrollment[]
  id               String              @id @default(cuid(2))
  cohortId         String
  cohort           Cohort              @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  programVersionId String
  programVersion   ProgramVersion      @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  fromSemesterId   String
  fromSemester     Semester            @relation("CohortStartSemester", fields: [fromSemesterId], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now())

  @@unique([cohortId, programVersionId])
  @@index([programVersionId])
}

model ProgramDirectorAssignment {
  id           String    @id @default(cuid(2))
  programId    String
  program      Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  directorId   String
  director     User      @relation("ProgramDirector", fields: [directorId], references: [id], onDelete: Restrict)
  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date
  assignedById String?
  assignedBy   User?     @relation("ProgramDirectorAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("ProgramDirectorRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())

  @@index([directorId])
  @@index([programId])
}

model Role {
  id              String                @id @default(cuid(2))
  roleCode        String                @unique
  roleName        String
  description     String?
  isSystemRole    Boolean               @default(false)
  scopeSource     ScopeSource           @default(NONE)
  rolePermissions RolePermission[]
  assignments     RoleAssignment[]
  approvalLevels  ApprovalLevelConfig[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model Permission {
  id              String           @id @default(cuid(2))
  permissionCode  String           @unique
  permissionName  String
  functionGroup   FunctionGroup
  description     String?
  source          String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String          @id @default(cuid(2))
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  mode         PermissionMode
  scope        PermissionScope
  updatedById  String?
  updatedBy    User?           @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleAssignment {
  id           String    @id @default(cuid(2))
  userId       String
  user         User      @relation("AssignmentHolder", fields: [userId], references: [id], onDelete: Restrict)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType    ScopeType
  scopeUnitId  String?
  scopeUnit    OrgUnit?  @relation(fields: [scopeUnitId], references: [id], onDelete: Restrict)
  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date
  assignedById String?
  assignedBy   User?     @relation("AssignmentGrantor", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("AssignmentRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, roleId, scopeUnitId, validFrom])
  @@index([userId])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Global list of knowledge blocks; a row's free-text blockSymbol is matched to blockCode when one exists, not enforced (F07-02).
model KnowledgeBlock {
  id              String   @id @default(cuid(2))
  blockCode       String   @unique
  blockName       String
  requiredCredits Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// With both minimums set, a student must meet both. Deleting a group leaves its rows elective with no group.
// A CHECK (at least one minimum) is added by hand in the migration: see database_and_models.md.
model ElectiveGroup {
  id         String           @id @default(cuid(2))
  versionId  String
  version    ProgramVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  groupCode  String
  groupName  String
  minCredits Decimal?         @db.Decimal(5, 2)
  minCourses Int?
  items      CurriculumItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([versionId, groupCode])
}

// sortOrder orders rows inside one semester; the "TT" number is derived. Credits and names are read live from Course until F-15 snapshots them.
// Five CHECK constraints are added by hand in the migration (not modelled by Prisma): see database_and_models.md.
model CurriculumItem {
  id                 String                @id @default(cuid(2))
  versionId          String
  version            ProgramVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  plannedSemester    Int
  sortOrder          Int
  courseId           String
  course             Course                @relation("CurriculumItemCourse", fields: [courseId], references: [id], onDelete: Restrict)
  blockSymbol        String?
  isElective         Boolean
  electiveGroupId    String?
  electiveGroup      ElectiveGroup?        @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)
  htDa               Boolean               @default(false)
  tqDa               Boolean               @default(false)
  minStudiedScore    Decimal?              @db.Decimal(4, 2)
  minTransferScore   Decimal?              @db.Decimal(4, 2)
  note               String?
  // Frozen at release (F-15); null on a Draft, which reads the live course.
  courseNameSnapshot String?
  creditsSnapshot    Decimal?              @db.Decimal(5, 2)
  // The syllabus revision this row is released with; null on a Draft (Published-else-Draft is read instead).
  syllabusId         String?
  syllabus           Syllabus?             @relation("CurriculumItemSyllabus", fields: [syllabusId], references: [id], onDelete: Restrict)
  requisites         CurriculumRequisite[]
  ploMappings        CoursePLOMapping[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([versionId, courseId])
  @@index([versionId, plannedSemester, sortOrder])
  @@index([courseId])
  @@index([electiveGroupId])
  @@index([syllabusId])
}

// Per-curriculum requisites, seeded from CourseRelation when the row is added and edited for this curriculum only.
model CurriculumRequisite {
  id             String             @id @default(cuid(2))
  itemId         String
  item           CurriculumItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceCourseId String
  sourceCourse   Course             @relation("CurriculumRequisiteSource", fields: [sourceCourseId], references: [id], onDelete: Restrict)
  relationType   CourseRelationType
  minScore       Decimal?           @db.Decimal(4, 2)
  createdAt      DateTime           @default(now())

  @@unique([itemId, sourceCourseId, relationType])
  @@index([sourceCourseId])
}

enum SyllabusStatus {
  DRAFT
  PUBLISHED
  HISTORICAL
}

enum AttachmentFileType {
  PDF
  DOCX
  XLSX
  IMAGE
}

enum SyllabusMaterialKind {
  SIGNED_SYLLABUS
  TEXTBOOK
  LECTURE_SLIDES
  OTHER
}

// One syllabus per course, kept as numbered revisions. Section texts are sanitized HTML (null = empty).
// The partial unique indexes (one Draft, one Published per course) and the CHECKs are added by hand in the migration.
// revisionNumber is null only on the working copy of a change request (sourceRequestId set, F-13).
model Syllabus {
  id                   String                @id @default(cuid(2))
  courseId             String
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  revisionNumber       Int?
  status               SyllabusStatus        @default(DRAFT)
  courseDescription    String?
  englishDescription   String?
  objectives           String?
  teachingMethods      String?
  assessmentMethods    String?
  references           String?
  previousVersionId    String?               @unique
  previousVersion      Syllabus?             @relation("SyllabusLineage", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion          Syllabus?             @relation("SyllabusLineage")
  publishedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  weeklyContents       WeeklyContent[]
  attachments          SyllabusAttachment[]
  clos                 CLO[]
  sourceRequestId      String?               @unique
  sourceRequest        ChangeRequest?        @relation("SyllabusRequestCopy", fields: [sourceRequestId], references: [id], onDelete: Restrict)
  baseRevisionId       String?
  baseRevision         Syllabus?             @relation("SyllabusBase", fields: [baseRevisionId], references: [id], onDelete: Restrict)
  requestCopies        Syllabus[]            @relation("SyllabusBase")
  // The request whose final approval published this revision (F-15).
  originRequestId      String?
  originRequest        ChangeRequest?        @relation("SyllabusOrigin", fields: [originRequestId], references: [id], onDelete: Restrict)
  pinnedItems          CurriculumItem[]      @relation("CurriculumItemSyllabus")
  // Course-level cutoff declaration; a unit-neutral number, never evaluated against scores.
  failingScore         Decimal?              @db.Decimal(9, 2)
  assessmentComponents AssessmentComponent[]

  @@unique([courseId, revisionNumber])
}

model WeeklyContent {
  id                 String             @id @default(cuid(2))
  syllabusId         String
  syllabus           Syllabus           @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  weekLabel          String
  sortOrder          Int
  content            String
  teachingActivities String?
  cloLinks           WeeklyContentCLO[]

  @@index([syllabusId, sortOrder])
}

// The file lives on disk under FILES_ROOT; filePath is relative with '/' separators.
model SyllabusAttachment {
  id           String               @id @default(cuid(2))
  syllabusId   String
  syllabus     Syllabus             @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  fileName     String
  fileType     AttachmentFileType
  materialKind SyllabusMaterialKind
  filePath     String               @unique
  sizeBytes    Int
  uploadedById String
  uploadedBy   User                 @relation("SyllabusAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime             @default(now())

  @@index([syllabusId, recordedAt])
}

model PLO {
  id                 String             @id @default(cuid(2))
  versionId          String
  version            ProgramVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  ploCode            String
  description        String
  englishDescription String?
  competencyGroup    String?
  sortOrder          Int
  courseMappings     CoursePLOMapping[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([versionId, ploCode])
  @@index([versionId, sortOrder])
}

// A CLO belongs to a syllabus revision, so every program using the course shares it (DEC-03).
model CLO {
  id                 String                 @id @default(cuid(2))
  syllabusId         String
  syllabus           Syllabus               @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  cloCode            String
  description        String
  englishDescription String?
  cognitiveLevel     String?
  sortOrder          Int
  ploLinks           CLOPLOMapping[]
  weeklyLinks        WeeklyContentCLO[]
  assessmentLinks    AssessmentCLOMapping[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([syllabusId, cloCode])
  @@index([syllabusId, sortOrder])
}

model WeeklyContentCLO {
  id              String        @id @default(cuid(2))
  weeklyContentId String
  weeklyContent   WeeklyContent @relation(fields: [weeklyContentId], references: [id], onDelete: Cascade)
  cloId           String
  clo             CLO           @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([weeklyContentId, cloId])
  @@index([cloId])
}

// weight in (0, 1], two decimals: CHECK "CoursePLOMapping_weight_range" is appended to the migration by hand.
model CoursePLOMapping {
  id               String          @id @default(cuid(2))
  curriculumItemId String
  curriculumItem   CurriculumItem  @relation(fields: [curriculumItemId], references: [id], onDelete: Cascade)
  ploId            String
  plo              PLO             @relation(fields: [ploId], references: [id], onDelete: Cascade)
  weight           Decimal         @db.Decimal(3, 2)
  cloLinks         CLOPLOMapping[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([curriculumItemId, ploId])
  @@index([ploId])
}

// Item and PLO are reached through the course cell: a link cannot outlive the cell it refines.
model CLOPLOMapping {
  id               String           @id @default(cuid(2))
  curriculumItemId String
  ploId            String
  coursePlo        CoursePLOMapping @relation(fields: [curriculumItemId, ploId], references: [curriculumItemId, ploId], onDelete: Cascade)
  cloId            String
  clo              CLO              @relation(fields: [cloId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())

  @@unique([curriculumItemId, cloId, ploId])
  @@index([cloId])
}

// A request of one of seven types; workspace types own a working copy (ProgramVersion / Syllabus with sourceRequestId).
// CHECKs (exactly one target key, basis number for UNIVERSITY origin, round >= 0) and the code sequence are added by hand in the migration.
model ChangeRequest {
  id                      String                     @id @default(cuid(2))
  requestCode             String                     @unique
  requestType             ChangeRequestType
  targetType              ChangeTargetType
  targetCode              String
  courseId                String?
  course                  Course?                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  programId               String?
  program                 Program?                   @relation(fields: [programId], references: [id], onDelete: Restrict)
  subjectGroupId          String?
  subjectGroup            SubjectGroup?              @relation(fields: [subjectGroupId], references: [id], onDelete: Restrict)
  createdById             String
  createdBy               User                       @relation("ChangeRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title                   String
  reason                  String
  status                  ChangeRequestStatus        @default(DRAFT)
  origin                  RequestOrigin
  basisDocumentNumber     String?
  submissionRound         Int                        @default(0)
  // Whether the creator held the academic-office role on the day of creation (F-15 reads it for past-semester releases).
  createdByAcademicOffice Boolean                    @default(false)
  // When the request entered its current PENDING_* level; null outside PENDING_* (days waiting, backlog filter).
  levelEnteredAt          DateTime?
  items                   ChangeItem[]
  steps                   ApprovalStep[]
  documents               ChangeRequestDocument[]
  comments                Comment[]
  notifications           Notification[]
  reminderDispatches      ApprovalReminderDispatch[]
  programCopy             ProgramVersion?            @relation("ProgramVersionRequestCopy")
  syllabusCopy            Syllabus?                  @relation("SyllabusRequestCopy")
  // Set by the final approval (F-15).
  decisionNumber          String?
  signedDate              DateTime?                  @db.Date
  effectiveSemesterId     String?
  effectiveSemester       Semester?                  @relation("RequestEffectiveSemester", fields: [effectiveSemesterId], references: [id], onDelete: Restrict)
  pastSemesterAllowed     Boolean                    @default(false)
  originatedVersions      ProgramVersion[]           @relation("ProgramVersionOrigin")
  originatedSyllabi       Syllabus[]                 @relation("SyllabusOrigin")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([courseId])
  @@index([programId])
  @@index([subjectGroupId])
}

// Stored at submit (workspace types) or authored while Draft (course and organisational types).
model ChangeItem {
  id              String        @id @default(cuid(2))
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  sortOrder       Int
  entityType      String
  itemKey         String
  label           String
  recordId        String?
  oldValue        Json?
  newValue        Json?
  baseVersion     String?

  @@unique([changeRequestId, entityType, itemKey])
  @@index([changeRequestId, sortOrder])
}

model ApprovalLevelConfig {
  id            String   @id @default(cuid(2))
  approvalLevel Int      @unique
  levelName     String
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One row per approver per level per submission round; level 3 has no approver (any other academic-office user acts).
// CHECKs (level 1..3, a skipped row has a reason) are added by hand in the migration.
model ApprovalStep {
  id                String              @id @default(cuid(2))
  changeRequestId   String
  changeRequest     ChangeRequest       @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  submissionRound   Int
  approvalLevel     Int
  approverId        String?
  approver          User?               @relation("ApprovalStepApprover", fields: [approverId], references: [id], onDelete: Restrict)
  forSubjectGroupId String?
  forSubjectGroup   SubjectGroup?       @relation(fields: [forSubjectGroupId], references: [id], onDelete: Restrict)
  forProgramId      String?
  forProgram        Program?            @relation(fields: [forProgramId], references: [id], onDelete: Restrict)
  action            ApprovalAction      @default(PENDING)
  remark            String?
  recordedAt        DateTime?
  isSkipped         Boolean             @default(false)
  skipReason        String?
  performedById     String?
  performedBy       User?               @relation("ApprovalStepPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  isOverride        Boolean             @default(false)
  // F-25: set only when a delegate decided this row on the approver's behalf; approverId stays the original reviewer.
  delegationId      String?
  delegation        ApprovalDelegation? @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())

  @@index([changeRequestId, submissionRound, approvalLevel])
  @@index([approverId, action])
  @@index([delegationId])
}

enum ApprovalDelegationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// F-25 (US-114): a dated grant to decide the delegator's named level-1/2 rows. It never copies a role.
// scopeLevel null = every named level the delegator holds; validFrom/validTo are inclusive Viet Nam days.
model ApprovalDelegation {
  id           String                   @id @default(cuid(2))
  delegatorId  String
  delegator    User                     @relation("DelegationGrantor", fields: [delegatorId], references: [id], onDelete: Restrict)
  delegateId   String
  delegate     User                     @relation("DelegationRecipient", fields: [delegateId], references: [id], onDelete: Restrict)
  scopeLevel   Int?
  validFrom    DateTime                 @db.Date
  validTo      DateTime                 @db.Date
  status       ApprovalDelegationStatus @default(ACTIVE)
  createdById  String
  createdBy    User                     @relation("DelegationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?                    @relation("DelegationRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason String?
  steps        ApprovalStep[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([delegateId, status, validFrom, validTo])
  @@index([delegatorId, status])
  @@index([status, validTo])
}

// F-25 (US-115): absent row = email on.
model NotificationPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
  UNKNOWN
}

// F-25 outbox: written with the notification, sent at most once by the email pump.
model NotificationEmailDelivery {
  notificationId String              @id
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         EmailDeliveryStatus @default(PENDING)
  attemptedAt    DateTime?
  sentAt         DateTime?
  finishedAt     DateTime?
  failureCode    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
}

// F-25 (US-116): one row per reminder sent, so a cycle reaches each recipient once.
model ApprovalReminderDispatch {
  id              String        @id @default(cuid(2))
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  submissionRound Int
  approvalLevel   Int
  levelEnteredAt  DateTime
  cycleIndex      Int
  recipientId     String
  recipient       User          @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([changeRequestId, submissionRound, approvalLevel, levelEnteredAt, cycleIndex, recipientId], map: "ApprovalReminderDispatch_cycle_recipient_key")
  @@index([recipientId, createdAt])
}

// No updatedAt on purpose: comments are never edited or deleted (US-067 AC3).
model Comment {
  id              String        @id @default(cuid(2))
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content         String
  createdAt       DateTime      @default(now())

  @@index([changeRequestId, createdAt])
}

// In-app only; content is the Vietnamese sentence rendered when the event happened.
model Notification {
  id               String                     @id @default(cuid(2))
  recipientId      String
  recipient        User                       @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notificationType NotificationType
  content          String
  changeRequestId  String?
  changeRequest    ChangeRequest?             @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  readStatus       NotificationReadStatus     @default(UNREAD)
  readAt           DateTime?
  createdAt        DateTime                   @default(now())
  emailDelivery    NotificationEmailDelivery?

  @@index([recipientId, readStatus, createdAt])
  @@index([changeRequestId])
}

// Scanned supporting documents; the file lives on disk under FILES_ROOT (relative path, '/' separators).
model ChangeRequestDocument {
  id              String             @id @default(cuid(2))
  changeRequestId String
  changeRequest   ChangeRequest      @relation(fields: [changeRequestId], references: [id], onDelete: Restrict)
  documentType    ChangeDocumentType
  fileName        String
  fileType        AttachmentFileType
  filePath        String             @unique
  sizeBytes       Int
  uploadedById    String
  uploadedBy      User               @relation("ChangeRequestDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  seenInRound     Int?
  createdAt       DateTime           @default(now())

  @@index([changeRequestId, createdAt])
}

// Declarative grade formula rows owned by one syllabus revision. The CHECKs are added by hand in the migration.
model AssessmentComponent {
  id                 String                 @id @default(cuid(2))
  syllabusId         String
  syllabus           Syllabus               @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  componentCode      String
  componentName      String
  weight             Decimal                @db.Decimal(5, 2)
  assessmentForm     String?
  isConditional      Boolean                @default(false)
  conditionThreshold Decimal?               @db.Decimal(9, 2)
  failingScore       Decimal?               @db.Decimal(9, 2)
  mappings           AssessmentCLOMapping[]

  @@unique([syllabusId, componentCode])
}

// A sparse cell of the assessment x CLO grid; cloWeight null still means mapped.
model AssessmentCLOMapping {
  id                    String              @id @default(cuid(2))
  assessmentComponentId String
  assessmentComponent   AssessmentComponent @relation(fields: [assessmentComponentId], references: [id], onDelete: Cascade)
  cloId                 String
  clo                   CLO                 @relation(fields: [cloId], references: [id], onDelete: Cascade)
  cloWeight             Decimal?            @db.Decimal(5, 2)

  @@unique([assessmentComponentId, cloId])
  @@index([cloId])
}

enum StudentStatus {
  STUDYING
  ON_LEAVE
  WITHDRAWN
  GRADUATED
}

enum StudentDataSource {
  EXCEL
  SCHOOL_DB
}

enum EnrollmentType {
  PRIMARY
  SECOND_MAJOR
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  ENDED
}

enum AcademicResultStatus {
  PASSED
  FAILED
  IN_PROGRESS
  EXEMPT
}

model Student {
  graduationContexts   GraduationAuditContext[]
  graduationBatchItems GraduationBatchItem[]
  id                   String                   @id @default(cuid(2))
  studentCode          String                   @unique
  fullName             String
  cohortId             String
  cohort               Cohort                   @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  admissionSemesterId  String
  admissionSemester    Semester                 @relation("StudentAdmissionSemester", fields: [admissionSemesterId], references: [id], onDelete: Restrict)
  statusSemesterId     String
  statusSemester       Semester                 @relation("StudentStatusSemester", fields: [statusSemesterId], references: [id], onDelete: Restrict)
  major                String
  status               StudentStatus            @default(STUDYING)
  dataSource           StudentDataSource        @default(EXCEL)
  userId               String?                  @unique
  user                 User?                    @relation("StudentAccount", fields: [userId], references: [id], onDelete: Restrict)
  enrollments          ProgramEnrollment[]
  academicResults      AcademicResult[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([cohortId, status])
  @@index([fullName, id])
}

model ProgramEnrollment {
  graduationAudits     GraduationAudit[]
  graduationBatchItems GraduationBatchItem[]
  id                   String                @id @default(cuid(2))
  studentId            String
  student              Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programId            String
  program              Program               @relation(fields: [programId], references: [id], onDelete: Restrict)
  cohortId             String
  cohort               Cohort                @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  appliedVersionId     String
  appliedVersion       ProgramVersion        @relation("EnrollmentAppliedVersion", fields: [appliedVersionId], references: [id], onDelete: Restrict)
  admissionVersionId   String
  admissionVersion     ProgramVersion        @relation("EnrollmentAdmissionVersion", fields: [admissionVersionId], references: [id], onDelete: Restrict)
  cohortAssignmentId   String?
  cohortAssignment     CohortVersion?        @relation(fields: [cohortAssignmentId], references: [id], onDelete: Restrict)
  fromSemesterId       String
  fromSemester         Semester              @relation("EnrollmentFromSemester", fields: [fromSemesterId], references: [id], onDelete: Restrict)
  untilSemesterId      String?
  untilSemester        Semester?             @relation("EnrollmentUntilSemester", fields: [untilSemesterId], references: [id], onDelete: Restrict)
  previousEnrollmentId String?               @unique
  previousEnrollment   ProgramEnrollment?    @relation("EnrollmentHistory", fields: [previousEnrollmentId], references: [id], onDelete: Restrict)
  nextEnrollment       ProgramEnrollment?    @relation("EnrollmentHistory")
  enrollmentType       EnrollmentType
  isException          Boolean               @default(false)
  basisDecision        String?
  status               EnrollmentStatus      @default(ACTIVE)
  createdById          String?
  createdBy            User?                 @relation("EnrollmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([studentId, programId])
  @@index([programId, cohortId, status, isException])
}

model AcademicResult {
  id          String                 @id @default(cuid(2))
  studentId   String
  student     Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  courseId    String
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semesterId  String
  semester    Semester               @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  score10     Decimal?               @db.Decimal(4, 2)
  score4      Decimal?               @db.Decimal(3, 2)
  letterGrade String?
  status      AcademicResultStatus
  dataSource  StudentDataSource      @default(EXCEL)
  revision    Int                    @default(1)
  changes     AcademicResultChange[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([studentId, courseId, semesterId])
  @@index([studentId, semesterId])
}

model AcademicResultChange {
  graduationReceipt GraduationResultChangeReceipt?
  id                String                         @id @default(cuid(2))
  academicResultId  String
  academicResult    AcademicResult                 @relation(fields: [academicResultId], references: [id], onDelete: Restrict)
  revision          Int
  before            Json?
  after             Json
  recordedAt        DateTime                       @default(now())

  @@unique([academicResultId, revision])
  @@index([recordedAt, id])
}

model StudentCredentialDelivery {
  batchId      String      @id
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountCount Int
  ciphertext   Bytes?
  iv           Bytes?
  authTag      Bytes?
  keyId        String?
  expiresAt    DateTime
  downloadedAt DateTime?
  createdAt    DateTime    @default(now())

  @@index([expiresAt])
}

enum GraduationConclusion {
  ELIGIBLE
  NOT_ELIGIBLE
}

enum GraduationAuditTrigger {
  STAFF
  BATCH
  RESULT_CHANGE
}

enum GraduationBatchStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum GraduationBatchItemStatus {
  PENDING
  REVIEWED
  ERROR
}

enum GraduationReauditStatus {
  PENDING
  RUNNING
  COMPLETED
  COVERED
  FAILED
}

model GraduationAuditContext {
  id           String                  @id @default(cuid(2))
  studentId    String
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programId    String
  program      Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  semesterId   String
  semester     Semester                @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lastAuditId  String?                 @unique
  lastAudit    GraduationAudit?        @relation("GraduationContextHead", fields: [lastAuditId], references: [id], onDelete: Restrict)
  audits       GraduationAudit[]       @relation("GraduationContextAudits")
  reauditTasks GraduationReauditTask[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([studentId, programId, semesterId])
  @@index([studentId])
}

model GraduationAudit {
  id               String                  @id @default(cuid(2))
  contextId        String
  context          GraduationAuditContext  @relation("GraduationContextAudits", fields: [contextId], references: [id], onDelete: Restrict)
  currentFor       GraduationAuditContext? @relation("GraduationContextHead")
  enrollmentId     String
  enrollment       ProgramEnrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  programVersionId String
  programVersion   ProgramVersion          @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  auditedAt        DateTime                @default(now())
  auditedById      String?
  auditedBy        User?                   @relation("GraduationReviewer", fields: [auditedById], references: [id], onDelete: Restrict)
  trigger          GraduationAuditTrigger
  operationKey     String                  @unique
  conclusion       GraduationConclusion
  schemaVersion    Int
  ruleVersion      String
  shortfalls       Json
  result           Json
  inputs           Json
  inputDigest      String
  supersedesId     String?                 @unique
  supersedes       GraduationAudit?        @relation("GraduationAuditChain", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy     GraduationAudit?        @relation("GraduationAuditChain")
  batchItem        GraduationBatchItem?
  baselineTasks    GraduationReauditTask[] @relation("GraduationTaskBaseline")
  completedTasks   GraduationReauditTask[] @relation("GraduationTaskResult")

  @@index([contextId, auditedAt, id])
  @@index([enrollmentId, auditedAt])
}

model GraduationBatch {
  id              String                @id @default(cuid(2))
  requestedById   String
  requestedBy     User                  @relation("GraduationBatchRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  requestKey      String
  filters         Json
  previewRevision String
  rosterDigest    String
  studentCount    Int
  enrollmentCount Int
  status          GraduationBatchStatus @default(QUEUED)
  failureCode     String?
  leaseToken      String?
  leaseUntil      DateTime?
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  items           GraduationBatchItem[]

  @@unique([requestedById, requestKey])
  @@index([status, leaseUntil, createdAt])
}

model GraduationBatchItem {
  id                 String                    @id @default(cuid(2))
  batchId            String
  batch              GraduationBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  studentId          String
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programId          String
  program            Program                   @relation(fields: [programId], references: [id], onDelete: Restrict)
  semesterId         String
  semester           Semester                  @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  rosterEnrollmentId String?
  rosterEnrollment   ProgramEnrollment?        @relation(fields: [rosterEnrollmentId], references: [id], onDelete: Restrict)
  rosterIdentity     Json
  status             GraduationBatchItemStatus @default(PENDING)
  auditId            String?                   @unique
  audit              GraduationAudit?          @relation(fields: [auditId], references: [id], onDelete: Restrict)
  errorCode          String?
  errorMessage       String?
  finishedAt         DateTime?

  @@unique([batchId, studentId, programId, semesterId])
  @@index([batchId, status, id])
}

model GraduationResultChangeReceipt {
  changeId    String                  @id
  change      AcademicResultChange    @relation(fields: [changeId], references: [id], onDelete: Restrict)
  targetCount Int
  reason      String?
  recordedAt  DateTime                @default(now())
  tasks       GraduationReauditTask[]
}

model GraduationReauditTask {
  id               String                        @id @default(cuid(2))
  changeId         String
  receipt          GraduationResultChangeReceipt @relation(fields: [changeId], references: [changeId], onDelete: Restrict)
  contextId        String
  context          GraduationAuditContext        @relation(fields: [contextId], references: [id], onDelete: Restrict)
  baselineAuditId  String
  baselineAudit    GraduationAudit               @relation("GraduationTaskBaseline", fields: [baselineAuditId], references: [id], onDelete: Restrict)
  completedAuditId String?
  completedAudit   GraduationAudit?              @relation("GraduationTaskResult", fields: [completedAuditId], references: [id], onDelete: Restrict)
  status           GraduationReauditStatus       @default(PENDING)
  attempts         Int                           @default(0)
  leaseToken       String?
  leaseUntil       DateTime?
  errorCode        String?
  createdAt        DateTime                      @default(now())
  finishedAt       DateTime?

  @@unique([changeId, contextId])
  @@index([status, leaseUntil, createdAt])
}

// F-22: optional read-only connector to the school's SQL Server. Excel stays the default source.
enum SchoolSyncMode {
  EXCEL_ONLY
  SCHOOL_DB
}

enum SchoolSyncProfile {
  SIMULATED_SQL_SERVER
  EXTERNAL_SQL_SERVER
}

enum SchoolSyncCadence {
  DAILY
  WEEKLY
}

enum SchoolSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SchoolSyncTrigger {
  SCHEDULED
  MANUAL
  RETRY
}

enum SchoolMappingKind {
  COHORT
  PROGRAM
  SEMESTER
  COURSE
}

enum SchoolConflictEntity {
  STUDENT
  ACADEMIC_RESULT
}

model SchoolSyncConfiguration {
  id                         String                   @id @default(cuid(2))
  singletonKey               String                   @unique @default("SCHOOL_DB")
  revision                   Int                      @default(1)
  mode                       SchoolSyncMode           @default(EXCEL_ONLY)
  profile                    SchoolSyncProfile        @default(SIMULATED_SQL_SERVER)
  enabled                    Boolean                  @default(false)
  sourceIdentity             String                   @default("SYNTHETIC-SCHOOL-V1")
  host                       String?
  port                       Int?
  database                   String?
  username                   String?
  passwordCiphertext         Bytes?
  passwordIv                 Bytes?
  passwordTag                Bytes?
  passwordKeyId              String?
  connectionRevision         Int                      @default(1)
  verifiedConnectionRevision Int?
  cadence                    SchoolSyncCadence        @default(DAILY)
  localTime                  String                   @default("02:00")
  weekday                    Int?
  nextDueAt                  DateTime?
  lastSuccessfulRunId        String?
  lastSnapshotVersion        String?
  mappings                   SchoolReferenceMapping[]
  classes                    SchoolClassMirror[]
  runs                       SyncLog[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

// Source code -> local code. The local target is checked on save and again inside every run.
model SchoolReferenceMapping {
  id              String                  @id @default(cuid(2))
  configurationId String
  configuration   SchoolSyncConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  kind            SchoolMappingKind
  sourceCode      String
  targetCode      String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([configurationId, kind, sourceCode])
}

// A mirror of the school's classes only; it has no academic meaning in the CMS.
model SchoolClassMirror {
  id                  String                  @id @default(cuid(2))
  configurationId     String
  configuration       SchoolSyncConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  sourceId            String
  classCode           String
  courseId            String
  course              Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semesterId          String
  semester            Semester                @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lastSnapshotVersion String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([configurationId, sourceId])
  @@index([courseId, semesterId])
}

model SyncLog {
  id                    String                  @id @default(cuid(2))
  configurationId       String
  configuration         SchoolSyncConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  requestKey            String                  @unique
  dataSource            String                  @default("SCHOOL_DB")
  profile               SchoolSyncProfile
  trigger               SchoolSyncTrigger
  requestedById         String?
  requestedBy           User?                   @relation("SchoolSyncRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  retryOfId             String?
  retryOf               SyncLog?                @relation("SchoolSyncRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retries               SyncLog[]               @relation("SchoolSyncRetry")
  configurationRevision Int
  status                SchoolSyncStatus        @default(RUNNING)
  workerToken           String?
  startedAt             DateTime                @default(now())
  expiresAt             DateTime
  finishedAt            DateTime?
  snapshotVersion       String?
  recordCount           Int                     @default(0)
  studentCount          Int                     @default(0)
  resultCount           Int                     @default(0)
  classCount            Int                     @default(0)
  changedCount          Int                     @default(0)
  conflictCount         Int                     @default(0)
  errorCode             String?
  errorMessage          String?
  conflicts             SyncConflict[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([startedAt, id])
  @@index([status, startedAt, id])
}

model SyncConflict {
  id             String               @id @default(cuid(2))
  syncLogId      String
  syncLog        SyncLog              @relation(fields: [syncLogId], references: [id], onDelete: Restrict)
  entityType     SchoolConflictEntity
  recordKey      String
  previousSource StudentDataSource
  selectedSource StudentDataSource
  fields         String[]
  before         Json
  after          Json
  createdAt      DateTime             @default(now())

  @@unique([syncLogId, entityType, recordKey])
}

enum IntegrationClientStatus {
  ACTIVE
  LOCKED
}

// F-21: a partner server (dDUT) reading /api/v1 with its own key; only the SHA-256 of the key is stored.
model IntegrationClient {
  id          String                  @id @default(cuid(2))
  clientName  String                  @unique
  keyHash     String                  @unique @db.Char(64)
  rateLimit   Int                     @default(60)
  status      IntegrationClientStatus @default(ACTIVE)
  createdById String
  createdBy   User                    @relation("IntegrationClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  windows     IntegrationRateWindow[]
  calls       IntegrationCallLog[]
}

// One fixed-minute counter per client, shared by every backend process.
model IntegrationRateWindow {
  clientId    String
  client      IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  windowStart DateTime          @db.Timestamptz(3)
  used        Int

  @@id([clientId, windowStart])
  @@index([windowStart])
}

// Append-only: a trigger refuses UPDATE and DELETE.
model IntegrationCallLog {
  id          String             @id @default(cuid(2))
  requestId   String             @unique
  clientId    String?
  client      IntegrationClient? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  resource    String
  studentCode String?
  occurredAt  DateTime           @default(now()) @db.Timestamptz(3)
  httpStatus  Int
  errorCode   String?
  durationMs  Int

  @@index([clientId, occurredAt])
  @@index([studentCode, occurredAt])
}
