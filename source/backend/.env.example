# --- Bắt buộc ---
DATABASE_URL=postgresql://ctdt:ctdt@localhost:5432/ctdt_real
# ≥ 32 ký tự. Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=vaylalancuoidibennhancaydangnhungkhongdau

# --- Chỉ cho seed (pnpm prisma:seed) ---
# Mật khẩu tài khoản R1 đầu tiên: ≥ 8 ký tự, có chữ và số
SEED_ADMIN_PASSWORD=keocon1234
# SEED_ADMIN_USERNAME=admin
# --- Tùy chọn (giá trị mặc định) ---
NODE_ENV=development
PORT=3000
REDIS_HOST=localhost
# Đổi nếu 6379 đã bị chiếm; compose cũng mở Redis ở cổng này
REDIS_PORT=6379
# Phiên hết hạn sau số phút không thao tác (NFR-08)
SESSION_IDLE_MINUTES=60
# Thư mục tệp đính kèm đề cương và đề xuất; ở máy chủ thật đặt trên ổ bền, có sao lưu
FILES_ROOT=E:\PBL6\curriculum-management\source\backend\syllabus
# Dung lượng tối đa một tệp đính kèm (MB)
ATTACHMENT_MAX_MB=20
# Tiền tố khóa Redis của hàng đợi BullMQ; chỉ đặt khi nhiều ứng dụng dùng chung một Redis
# BULLMQ_PREFIX=ctdt

# --- Đồng bộ CSDL Trường (F-22, tùy chọn) ---
# Khóa AES-256 (base64 của 32 byte) mã hóa mật khẩu kết nối. Thiếu thì không lưu được kết nối.
# SCHOOL_SYNC_ENCRYPTION_KEY=
# Tên máy chủ SQL Server của Trường được phép, cách nhau bằng dấu phẩy. Trống: chỉ dùng bản mô phỏng trên máy này.
# SCHOOL_SYNC_EXTERNAL_HOSTS=
# Mật khẩu tài khoản sa và tài khoản chỉ đọc của bản mô phỏng (pnpm school-db:sim:start)
# SCHOOL_DB_SIM_SA_PASSWORD=
# SCHOOL_DB_SIM_READER_PASSWORD=

# --- docker compose (pnpm services:up) ---
POSTGRES_USER=ctdt
POSTGRES_PASSWORD=ctdt
POSTGRES_DB=ctdt
POSTGRES_PORT=5432
# F-25 email (outbox pump) and approval deadline reminders. Off by default; `pnpm mail:start` runs Mailpit on 1025/8025.
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CTĐT Khoa CNTT <no-reply@localhost>"
APP_BASE_URL=http://localhost:5173
REMINDERS_ENABLED=false
REMINDER_MAX_DAYS=7
REMINDER_REPEAT_DAYS=3
