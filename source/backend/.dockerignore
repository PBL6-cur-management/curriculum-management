# Allowlist: exclude everything, then re-include only the build inputs.
**
!package.json
!pnpm-lock.yaml
!prisma.config.ts
!nest-cli.json
!tsconfig.json
!tsconfig.build.json
!prisma/schema.prisma
!prisma/migrations/**
!prisma/seed.ts
!prisma/seed-extra-faculties.ts
!prisma/seed-extra-full.ts
!prisma/seed-tracks-from-notes.ts
!prisma/demo-account.ts
!prisma/demo-fixtures.ts
!prisma/seed-data/approval-levels.ts
!prisma/seed-data/knowledge-blocks.ts
!prisma/seed-data/majors.ts
!prisma/seed-data/org-units.ts
!prisma/seed-data/permission-catalog.ts
!prisma/seed-data/programs.ts
!prisma/seed-data/roles.ts
!prisma/seed-data/seed-access-control.ts
!prisma/seed-data/semesters.ts
!prisma/seed-data/dut/**
!prisma/seed-data/dut/data/extra-faculties.json
!prisma/seed-data/dut/data/extra-syllabi-outcomes.json
!src/**
!assets/**
# Never in an image: secrets, host-built output, tests, generated client, local data.
**/.env
**/.env.*
**/node_modules
**/dist
**/*.spec.ts
prisma/seed-data/dut/data/private/**
src/generated/**
storage/**
