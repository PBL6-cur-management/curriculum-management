# Demo environment for deploy/compose.yaml on the Oracle Cloud VM. The real file is /srv/ctdt/demo.env
# (chmod 600, owner ubuntu) and never leaves the VM. Fill every <...> on the VM itself:
#   openssl rand -base64 48 | tr -d '\n'   → SESSION_SECRET
#   openssl rand -hex 24                   → POSTGRES_PASSWORD (hex: safe inside DATABASE_URL)

# --- Images (multi-arch: the VM is ARM64) ---
NODE_IMAGE=node:24.22.2-bookworm-slim
POSTGRES_IMAGE=postgres:18.6-bookworm
REDIS_IMAGE=redis:8.2.11-bookworm
CADDY_IMAGE=caddy:2.11.7-alpine
# deploy-release.sh sets RELEASE_TAG to the commit SHA on every deploy; this value is only a fallback.
RELEASE_TAG=manual

# --- Public name (A record at tenten.vn → reserved IP from `terraform output public_ip`) ---
PUBLIC_HOST=ctdt.oguri-lab.io.vn

# --- Database ---
POSTGRES_USER=ctdt
POSTGRES_DB=ctdt_real
POSTGRES_PASSWORD=<hex>
DATABASE_URL=postgresql://ctdt:<same hex>@postgres:5432/ctdt_real

# --- Application ---
SESSION_SECRET=<base64, at least 32 characters>
FILES_PATH=/srv/ctdt/files
LOG_LEVEL=info
# Adds Chromium to the API image so curriculum PDFs render (F-24).
API_BUILD_TARGET=runtime-chromium
