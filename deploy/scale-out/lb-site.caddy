# Plain-HTTP site the OCI load balancer calls (TLS ends on the LB). Reached only from 10.0.1.0/24.
:8080 {
	encode zstd gzip

	@docs path /api/docs /api/docs/* /api/docs-json
	handle @docs {
		respond 404
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			# The browser spoke HTTPS to the LB; the backend trusts exactly one hop (this Caddy),
			# so tell it the original scheme or the Secure session cookie is never set.
			header_up X-Forwarded-Proto https
		}
	}

	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
